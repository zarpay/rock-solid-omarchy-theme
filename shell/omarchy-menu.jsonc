{
  // ZAR brand glyphs from the ZARIcons font (built from the 2D icon set).
  // Entries are full copies of the stock rows with only icon/iconFont changed,
  // because an override replaces every field of the row.
  // Codepoint map: ~/.config/omarchy/themes/zar/src/zar-icons-codepoints.json
  "apps": {"icon": "", "label": "Apps", "aliases": ["app", "applications"], "provider": "apps", "iconFont": "ZARIcons"},
  "learn": {"icon": "", "label": "Learn", "iconFont": "ZARIcons"},
  "trigger": {"icon": "", "label": "Trigger", "iconFont": "ZARIcons"},
  "style": {"icon": "", "label": "Style", "iconFont": "ZARIcons"},
  "setup": {"icon": "", "label": "Setup", "aliases": ["settings"], "iconFont": "ZARIcons"},
  "install": {"icon": "", "label": "Install", "iconFont": "ZARIcons"},
  "remove": {"icon": "", "label": "Remove", "aliases": ["uninstall"], "iconFont": "ZARIcons"},
  "update": {"icon": "", "label": "Update", "aliases": ["restart", "refresh"], "iconFont": "ZARIcons"},
  "about": {"icon": "", "label": "About", "action": "omarchy-launch-about", "iconFont": "ZARIcons"},
  "system": {"icon": "", "label": "System", "aliases": ["power-menu"], "iconFont": "ZARIcons"},
  "system.screensaver": {"icon": "", "label": "Screensaver", "action": "omarchy-launch-screensaver force", "iconFont": "ZARIcons"},
  "system.lock": {"icon": "", "label": "Lock", "action": "omarchy-system-lock", "iconFont": "ZARIcons"},
  "system.suspend": {"icon": "", "label": "Suspend", "when": "! omarchy-toggle-enabled suspend-off", "action": "systemctl suspend", "iconFont": "ZARIcons"},
  "system.hibernate": {"icon": "", "label": "Hibernate", "when": "omarchy-hibernation-available", "action": "systemctl hibernate", "iconFont": "ZARIcons"},
  "system.logout": {"icon": "", "label": "Logout", "action": "omarchy-system-logout", "iconFont": "ZARIcons"},
  "system.reboot": {"icon": "", "label": "Reboot", "action": "omarchy-system-reboot", "iconFont": "ZARIcons"},
  "system.shutdown": {"icon": "", "label": "Shutdown", "action": "omarchy-system-shutdown", "iconFont": "ZARIcons"},
  "style.theme": {"icon": "", "label": "Theme", "aliases": ["theme", "themes"], "action": "theme=$(omarchy-theme-switcher); [[ -n $theme ]] && omarchy-theme-set \"$theme\"", "iconFont": "ZARIcons"},
  "style.background": {"icon": "", "label": "Background", "aliases": ["background", "wallpaper"], "action": "background=$(omarchy-theme-bg-switcher); [[ -n $background ]] && omarchy-theme-bg-set \"$background\"", "iconFont": "ZARIcons"},
  "style.unlock": {"icon": "", "label": "Unlock", "aliases": ["unlock"], "action": "unlock=$(omarchy-plymouth-switcher); if [[ $unlock == default ]]; then omarchy-launch-floating-terminal-with-presentation omarchy-plymouth-reset; elif [[ -n $unlock ]]; then omarchy-launch-floating-terminal-with-presentation \"omarchy-plymouth-set-by-theme $(printf %q \"$unlock\")\"; fi", "iconFont": "ZARIcons"},
  "style.font": {"icon": "", "label": "Font", "provider": "fonts", "iconFont": "ZARIcons"},
  "style.bar": {"icon": "", "label": "Menu Bar", "iconFont": "ZARIcons"},
  "style.hyprland": {"icon": "", "label": "Hyprland", "action": "omarchy-launch-config-editor \"$HOME/.config/hypr/looknfeel.lua\"", "iconFont": "ZARIcons"},
  "style.screensaver": {"icon": "", "label": "Screensaver", "iconFont": "ZARIcons"},
  "style.about": {"icon": "", "label": "About", "iconFont": "ZARIcons"},
  "setup.monitors": {"icon": "", "label": "Monitors", "action": "omarchy-launch-config-editor \"$HOME/.config/hypr/monitors.lua\"", "iconFont": "ZARIcons"},
  "setup.keybindings": {"icon": "", "label": "Keybindings", "when": "[[ -f ~/.config/hypr/bindings.lua ]]", "action": "omarchy-launch-config-editor \"$HOME/.config/hypr/bindings.lua\"", "iconFont": "ZARIcons"},
  "setup.input": {"icon": "", "label": "Input", "when": "[[ -f ~/.config/hypr/input.lua ]]", "action": "omarchy-launch-config-editor \"$HOME/.config/hypr/input.lua\"", "iconFont": "ZARIcons"},
  "setup.network": {"icon": "", "label": "Network", "aliases": ["network"], "iconFont": "ZARIcons"},
  "setup.default": {"icon": "", "label": "Defaults", "aliases": ["default", "defaults"], "iconFont": "ZARIcons"},
  "setup.plugin": {"icon": "", "label": "Plugins", "aliases": ["plugin", "plugins"], "iconFont": "ZARIcons"},
  "setup.security": {"icon": "", "label": "Security", "iconFont": "ZARIcons"},
  "setup.config": {"icon": "", "label": "Config", "iconFont": "ZARIcons"},
  "setup.direct-boot": {"icon": "", "label": "Direct Boot", "action": "omarchy-launch-floating-terminal-with-presentation omarchy-setup-direct-boot", "iconFont": "ZARIcons"},
  "setup.reset": {"icon": "", "label": "Reset Computer", "when": "[[ $(findmnt -no FSTYPE /) == btrfs ]]", "action": "omarchy-launch-floating-terminal-with-presentation omarchy-system-factory-reset", "iconFont": "ZARIcons"}
}
